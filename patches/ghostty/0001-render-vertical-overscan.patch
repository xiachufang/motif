+test "vertical overscan rows" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var t = try Terminal.init(io, alloc, .{
+        .cols = 10,
+        .rows = 2,
+    });
+    defer t.deinit(alloc);
+
+    var s = t.vtStream();
+    defer s.deinit();
+    s.nextSlice("A\r\nB\r\nC\r\nD\r\n");
+
+    var state: RenderState = .empty;
+    defer state.deinit(alloc);
+
+    // By default the render state contains exactly the viewport rows.
+    try state.update(alloc, &t);
+    try testing.expectEqual(@as(usize, 2), state.row_data.len);
+
+    // Move one row above the active area. Enabling overscan without any
+    // other terminal change must add the surrounding rows.
+    t.scrollViewport(.{ .delta = -1 });
+    try state.update(alloc, &t);
+    const viewport_pin = state.row_data.items(.pin)[0];
+    const expected_top_pin = viewport_pin.up(1).?;
+    const expected_bottom_pin = viewport_pin.down(2).?;
+
+    state.vertical_overscan = true;
+    try state.update(alloc, &t);
+    try testing.expectEqual(@as(usize, 4), state.row_data.len);
+    try testing.expect(expected_top_pin.eql(state.row_data.items(.pin)[0]));
+    try testing.expect(viewport_pin.eql(state.row_data.items(.pin)[1]));
+    try testing.expect(expected_bottom_pin.eql(state.row_data.items(.pin)[3]));
+
+    // The cursor is in the bottom overscan row, not the viewport itself.
+    try testing.expect(state.cursor.viewport == null);
+
+    // At the active area only the top overscan row exists. The cursor remains
+    // in the viewport and its coordinate does not include the overscan row.
+    t.scrollViewport(.bottom);
+    try state.update(alloc, &t);
+    try testing.expectEqual(@as(usize, 3), state.row_data.len);
+    try testing.expectEqual(@as(size.CellCountInt, 1), state.cursor.viewport.?.y);
+}
