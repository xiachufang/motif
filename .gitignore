# IDE
.vscode/
.idea/
.claude/

# Xcode / iOS build artifacts
apps/ios/build/
apps/ios/DerivedData/
apps/ios/.swiftpm/
apps/ios/**/*.xcuserstate
apps/ios/**/xcuserdata/
apps/ios/**/xcshareddata/IDEWorkspaceChecks.plist
apps/ios/Motif.xcodeproj/
apps/ios/Motif/Resources/web/
apps/ios/vendor

# Local deployment secrets must never be committed.
/deploy/*/secrets/
*.p8

# Local Codex credentials used by the App Review container.
/deploy/review/secret/
